# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://summitokr:summitokr123@localhost:5432/summit_okr?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_me_in_prod_at_least_32_chars_long
JWT_REFRESH_SECRET=your_refresh_secret_change_me_in_prod_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# App
APP_NAME=Summit OKR
APP_VERSION=1.0.0

# AI (DeepSeek, OpenAI 兼容). 未填 AI_API_KEY 时自动启用 Mock 模式
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MOCK=true
AI_DAILY_LIMIT=50
